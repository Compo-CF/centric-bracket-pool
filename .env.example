# Copy to .env.local for local development. These values are public by design --
# Firestore security rules are what protect the data, not this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Belt-and-braces client check. Entra tenant scoping is the real gate.
VITE_ALLOWED_EMAIL_DOMAIN=centricfiber.com

# Entra directory (tenant) id, so only Centric accounts can sign in.
VITE_MICROSOFT_TENANT_ID=
