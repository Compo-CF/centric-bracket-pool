{
  "name": "centric-bracket-pool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Company NCAA tournament bracket pool. Static front end on GitHub Pages, Firestore behind it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pool:status": "tsx scripts/status.ts",
    "pool:seed-config": "tsx scripts/seed-config.ts",
    "pool:seed-bracket": "tsx scripts/seed-bracket.ts",
    "pool:standings": "tsx scripts/rebuild-standings.ts",
    "pool:grant-admin": "tsx scripts/grant-admin.ts",
    "pool:sync": "tsx scripts/sync-results.ts",
    "pool:set-result": "tsx scripts/set-result.ts",
    "pool:import-field": "tsx scripts/import-field.ts"
  },
  "devDependencies": {
    "firebase-admin": "^14.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "firebase": "^11.1.0"
  }
}
